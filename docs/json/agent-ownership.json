{
  "contract": "agent-ownership-and-lifecycle",
  "contract_version": "1.0",
  "authority": "docs/md/TRIPSTATE_OWNERSHIP_AND_LIFECYCLE.md",
  "path_matching": {
    "write_paths_are_prefixes": true,
    "agents_may_write_descendants": true,
    "root_replace_allowed": false,
    "absolute_paths_required": true
  },
  "patch": {
    "allowed_operations": ["add", "replace", "remove", "test"],
    "prohibited_operations": ["move", "copy"],
    "atomic": true,
    "no_op_creates_version": false,
    "rejection_creates_version": false,
    "error_codes": [
      "PATCH_UNAUTHENTICATED_AGENT",
      "PATCH_INVALID_OPERATION",
      "PATCH_INVALID_PATH",
      "PATCH_OWNERSHIP_VIOLATION",
      "PATCH_ORCHESTRATOR_FIELD",
      "PATCH_TEST_FAILED",
      "PATCH_CONFLICT",
      "PATCH_VALIDATION_FAILED",
      "INVALID_STATE_TRANSITION"
    ]
  },
  "orchestrator_only_paths": [
    "/schema_version",
    "/trip",
    "/status",
    "/version",
    "/parent_version",
    "/run",
    "/events"
  ],
  "agents": {
    "1": {"name": "Discovery", "write_paths": ["/traveler_profile"]},
    "2": {"name": "Constraint & Preference", "write_paths": ["/constraints"]},
    "3": {
      "name": "Experience Designer",
      "write_paths": ["/destination", "/city_allocations", "/experience_catalog", "/candidates/skeletons"],
      "must_not_write": ["/candidates/ranked", "/candidates/active_candidate_id", "/itinerary", "/optimization"]
    },
    "4": {"name": "Mobility & Logistics", "write_paths": ["/evaluations/mobility"]},
    "5": {"name": "Cost Optimization", "write_paths": ["/evaluations/cost"]},
    "6": {"name": "Local Intelligence", "write_paths": ["/evaluations/local"]},
    "7": {"name": "Simulation & Risk", "write_paths": ["/evaluations/simulation"]},
    "8": {
      "name": "Optimization",
      "write_paths": ["/candidates/ranked", "/candidates/active_candidate_id", "/itinerary", "/optimization"],
      "must_not_write": ["/candidates/skeletons"]
    },
    "9": {"name": "Narrative & Explanation", "write_paths": ["/narrative"]},
    "10": {"name": "Continuous Replanning", "write_paths": ["/replanning"]}
  },
  "lifecycle": {
    "initial_status": "draft",
    "allowed_statuses": [
      "draft",
      "discovery_in_progress",
      "ready_to_plan",
      "planning",
      "awaiting_user_decision",
      "planned",
      "failed"
    ],
    "terminal_statuses": ["failed"],
    "only_listed_transitions_are_valid": true,
    "allowed_transitions": [
      {"from": "draft", "to": "discovery_in_progress", "condition": "discovery_started"},
      {"from": "discovery_in_progress", "to": "ready_to_plan", "condition": "profile_normalized_and_no_blocking_unknown"},
      {"from": "discovery_in_progress", "to": "failed", "condition": "discovery_terminal_failure"},
      {"from": "ready_to_plan", "to": "planning", "condition": "planning_run_started"},
      {"from": "ready_to_plan", "to": "failed", "condition": "planning_start_terminal_failure"},
      {"from": "planning", "to": "awaiting_user_decision", "condition": "no_acceptable_plan_and_decision_required"},
      {"from": "planning", "to": "planned", "condition": "valid_ranked_candidate_and_complete_final_plan"},
      {"from": "planning", "to": "failed", "condition": "planning_terminal_failure"},
      {"from": "awaiting_user_decision", "to": "planning", "condition": "decision_or_relaxation_accepted"},
      {"from": "awaiting_user_decision", "to": "failed", "condition": "decision_abandoned_or_unexecutable"},
      {"from": "planned", "to": "planning", "condition": "replan_or_alternative_requested"}
    ]
  },
  "versions": {
    "first_version": 1,
    "immutable": true,
    "increment_by": 1,
    "parent_version_is_previous_current_version": true,
    "state_change_creates_exactly_one_version": true,
    "agents_assign_versions": false
  },
  "events": {
    "emitter": "orchestrator",
    "required_after_commit": ["state.version_created"],
    "required_after_transition": ["state.transitioned"],
    "rejection_event": "agent.patch_rejected",
    "rejection_has_no_new_version": true,
    "no_op_has_no_state_change_event": true,
    "durable_or_retried": true
  }
}
