{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-travel-planner.local/contracts/trip-state/1.0.0",
  "title": "Agentic Travel Planner TripState",
  "type": "object",
  "required": ["schema_version", "trip", "status", "version", "traveler_profile", "trip_request", "constraints", "candidates", "run"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "trip": { "$ref": "#/$defs/Trip" },
    "status": { "enum": ["draft", "discovery_in_progress", "ready_to_plan", "planning", "awaiting_user_decision", "planned", "failed"] },
    "version": { "type": "integer", "minimum": 1 },
    "parent_version": { "type": ["integer", "null"], "minimum": 1 },
    "traveler_profile": { "$ref": "#/$defs/TravelerProfile" },
    "trip_request": { "$ref": "#/$defs/TripRequest" },
    "constraints": { "$ref": "#/$defs/Constraints" },
    "destination": { "$ref": "#/$defs/Destination" },
    "cities": { "type": "array", "items": { "$ref": "#/$defs/CityAllocation" } },
    "experience_catalog": { "type": "array", "items": { "$ref": "#/$defs/Experience" } },
    "transportation_options": { "type": "array", "items": { "$ref": "#/$defs/TransportationOption" } },
    "candidates": { "type": "array", "maxItems": 3, "items": { "$ref": "#/$defs/CandidateItinerary" } },
    "active_candidate_id": { "type": ["string", "null"] },
    "itinerary": { "$ref": "#/$defs/Itinerary" },
    "simulation": { "$ref": "#/$defs/SimulationResult" },
    "optimization": { "$ref": "#/$defs/OptimizationResult" },
    "narrative": { "$ref": "#/$defs/Narrative" },
    "data_facts": { "type": "array", "items": { "$ref": "#/$defs/DataFact" } },
    "warnings": { "type": "array", "items": { "$ref": "#/$defs/Warning" } },
    "run": { "$ref": "#/$defs/PlanningRun" },
    "events": { "type": "array", "items": { "$ref": "#/$defs/PlanningEvent" } }
  },
  "additionalProperties": false,
  "$defs": {
    "Id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "Timestamp": { "type": "string", "format": "date-time", "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$" },
    "Currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "Score": { "type": "number", "minimum": 0, "maximum": 100 },
    "Confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "Money": { "type": "object", "required": ["amount", "currency"], "properties": { "amount": { "type": "number", "minimum": 0 }, "currency": { "$ref": "#/$defs/Currency" } }, "additionalProperties": false },
    "DataFact": { "type": "object", "required": ["source", "observed_at", "fresh_until", "confidence"], "properties": { "source": { "type": "string" }, "observed_at": { "$ref": "#/$defs/Timestamp" }, "fresh_until": { "$ref": "#/$defs/Timestamp" }, "confidence": { "$ref": "#/$defs/Confidence" }, "cached": { "type": "boolean", "default": false } }, "additionalProperties": false },
    "Trip": { "type": "object", "required": ["trip_id", "created_at", "updated_at"], "properties": { "trip_id": { "$ref": "#/$defs/Id" }, "created_at": { "$ref": "#/$defs/Timestamp" }, "updated_at": { "$ref": "#/$defs/Timestamp" }, "planning_currency": { "$ref": "#/$defs/Currency" } }, "additionalProperties": false },
    "TravelerProfile": { "type": "object", "required": ["profile_id", "preference_weights"], "properties": { "profile_id": { "$ref": "#/$defs/Id" }, "party_size": { "type": "integer", "minimum": 1 }, "purpose": { "type": "string" }, "preference_weights": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 } }, "walking_tolerance": { "$ref": "#/$defs/Confidence" }, "crowd_tolerance": { "$ref": "#/$defs/Confidence" }, "pace": { "enum": ["slow", "balanced", "fast"] }, "answers_complete": { "type": "boolean", "default": false } }, "additionalProperties": false },
    "TripRequest": { "type": "object", "required": ["request_id", "destination_query", "start_date", "end_date", "travelers"], "properties": { "request_id": { "$ref": "#/$defs/Id" }, "destination_query": { "type": "string" }, "start_date": { "type": "string", "format": "date" }, "end_date": { "type": "string", "format": "date" }, "travelers": { "type": "integer", "minimum": 1 }, "budget": { "$ref": "#/$defs/Money" } }, "additionalProperties": false },
    "Constraints": { "type": "object", "required": ["hard", "soft_weights"], "properties": { "hard": { "type": "object", "properties": { "budget_ceiling": { "$ref": "#/$defs/Money" }, "must_visit": { "type": "array", "items": { "type": "string" } }, "avoid": { "type": "array", "items": { "type": "string" } }, "dietary": { "type": "array", "items": { "type": "string" } }, "accessibility": { "type": "array", "items": { "type": "string" } }, "max_hotel_changes": { "type": "integer", "minimum": 0 } }, "additionalProperties": false }, "soft_weights": { "type": "object", "additionalProperties": { "$ref": "#/$defs/Confidence" } }, "objective_version": { "type": "string", "default": "1.0.0" } }, "additionalProperties": false },
    "Destination": { "type": "object", "required": ["country"], "properties": { "country": { "type": "string" }, "region": { "type": "string" }, "timezone": { "type": "string" } }, "additionalProperties": false },
    "CityAllocation": { "type": "object", "required": ["city_id", "name", "nights"], "properties": { "city_id": { "$ref": "#/$defs/Id" }, "name": { "type": "string" }, "nights": { "type": "integer", "minimum": 0 }, "order": { "type": "integer", "minimum": 1 } }, "additionalProperties": false },
    "Experience": { "type": "object", "required": ["experience_id", "name", "city_id", "duration_minutes", "estimated_cost", "data_fact"], "properties": { "experience_id": { "$ref": "#/$defs/Id" }, "name": { "type": "string" }, "city_id": { "$ref": "#/$defs/Id" }, "categories": { "type": "array", "items": { "type": "string" } }, "duration_minutes": { "type": "integer", "minimum": 1 }, "estimated_cost": { "$ref": "#/$defs/Money" }, "opening_hours_verified": { "type": "boolean" }, "data_fact": { "$ref": "#/$defs/DataFact" } }, "additionalProperties": false },
    "TransportationOption": { "type": "object", "required": ["option_id", "from", "to", "duration_minutes", "estimated_cost", "data_fact"], "properties": { "option_id": { "$ref": "#/$defs/Id" }, "from": { "type": "string" }, "to": { "type": "string" }, "mode": { "enum": ["walk", "transit", "train", "bus", "flight", "taxi", "ferry"] }, "duration_minutes": { "type": "integer", "minimum": 0 }, "estimated_cost": { "$ref": "#/$defs/Money" }, "transfers": { "type": "integer", "minimum": 0 }, "data_fact": { "$ref": "#/$defs/DataFact" } }, "additionalProperties": false },
    "CandidateItinerary": { "type": "object", "required": ["candidate_id", "branch", "feasible", "hard_constraint_failures", "score_components", "confidence"], "properties": { "candidate_id": { "$ref": "#/$defs/Id" }, "branch": { "enum": ["initial", "minimal_change", "full_reoptimization", "alternative"] }, "rank": { "type": "integer", "minimum": 1, "maximum": 3 }, "feasible": { "type": "boolean" }, "hard_constraint_failures": { "type": "array", "items": { "$ref": "#/$defs/Failure" } }, "mobility": { "type": "object", "properties": { "feasible": { "type": "boolean" }, "transit_minutes": { "type": "integer", "minimum": 0 }, "transfer_count": { "type": "integer", "minimum": 0 } }, "additionalProperties": false }, "cost": { "type": "object", "properties": { "total": { "$ref": "#/$defs/Money" }, "within_budget": { "type": "boolean" }, "substitutions": { "type": "array", "items": { "type": "string" } } }, "additionalProperties": false }, "local_advice": { "type": "array", "items": { "type": "string" } }, "total_cost": { "$ref": "#/$defs/Money" }, "score_components": { "$ref": "#/$defs/ScoreComponents" }, "confidence": { "$ref": "#/$defs/Confidence" }, "assumptions": { "type": "array", "items": { "type": "string" } }, "tradeoffs": { "type": "array", "items": { "type": "string" } }, "itinerary": { "$ref": "#/$defs/Itinerary" }, "simulation": { "$ref": "#/$defs/SimulationResult" } }, "additionalProperties": false },
    "ScoreComponents": { "type": "object", "required": ["preference_fit", "experience_quality", "comfort", "authenticity", "fatigue", "cost_penalty", "logistics_penalty", "regret_risk", "disruption_penalty", "overall_score"], "properties": { "preference_fit": { "$ref": "#/$defs/Score" }, "experience_quality": { "$ref": "#/$defs/Score" }, "comfort": { "$ref": "#/$defs/Score" }, "authenticity": { "$ref": "#/$defs/Score" }, "fatigue": { "$ref": "#/$defs/Score" }, "cost_penalty": { "$ref": "#/$defs/Score" }, "logistics_penalty": { "$ref": "#/$defs/Score" }, "regret_risk": { "$ref": "#/$defs/Score" }, "disruption_penalty": { "$ref": "#/$defs/Score" }, "overall_score": { "type": "number", "minimum": -500, "maximum": 400 } }, "additionalProperties": false },
    "Itinerary": { "type": "object", "properties": { "days": { "type": "array", "items": { "type": "object", "required": ["date", "city_id", "activities"], "properties": { "date": { "type": "string", "format": "date" }, "city_id": { "$ref": "#/$defs/Id" }, "activities": { "type": "array", "items": { "type": "object", "required": ["experience_id", "start_at", "end_at"], "properties": { "experience_id": { "$ref": "#/$defs/Id" }, "start_at": { "$ref": "#/$defs/Timestamp" }, "end_at": { "$ref": "#/$defs/Timestamp" }, "timezone": { "type": "string" }, "completed": { "type": "boolean", "default": false } }, "additionalProperties": false } } }, "additionalProperties": false } } }, "additionalProperties": false },
    "SimulationResult": { "type": "object", "properties": { "feasible": { "type": "boolean" }, "fatigue_risk": { "$ref": "#/$defs/Score" }, "walking_minutes": { "type": "integer", "minimum": 0 }, "warnings": { "type": "array", "items": { "$ref": "#/$defs/Warning" } } }, "additionalProperties": false },
    "OptimizationResult": { "type": "object", "properties": { "objective_version": { "type": "string" }, "selected_candidate_id": { "$ref": "#/$defs/Id" }, "candidate_count": { "type": "integer", "minimum": 0, "maximum": 3 }, "tie_breaker": { "const": "candidate_id_ascending" } }, "additionalProperties": false },
    "ReplanningRequest": { "type": "object", "required": ["request_id", "type", "occurred_at", "description"], "properties": { "request_id": { "$ref": "#/$defs/Id" }, "type": { "enum": ["weather", "closure", "budget_change", "duration_change", "fatigue", "delay", "preference_change", "party_change"] }, "occurred_at": { "$ref": "#/$defs/Timestamp" }, "description": { "type": "string" }, "affected_activity_ids": { "type": "array", "items": { "$ref": "#/$defs/Id" } } }, "additionalProperties": false },
    "Narrative": { "type": "object", "properties": { "summary": { "type": "string" }, "decision_explanations": { "type": "array", "items": { "type": "string" } } }, "additionalProperties": false },
    "Warning": { "type": "object", "required": ["code", "message", "severity"], "properties": { "code": { "type": "string" }, "message": { "type": "string" }, "severity": { "enum": ["info", "warning", "error"] } }, "additionalProperties": false },
    "Failure": { "type": "object", "required": ["code", "message", "retryable"], "properties": { "code": { "type": "string" }, "message": { "type": "string" }, "retryable": { "type": "boolean" }, "owner_agent": { "type": "integer", "minimum": 1, "maximum": 10 } }, "additionalProperties": false },
    "PlanningRun": {
      "type": "object",
      "required": ["run_id", "status", "started_at"],
      "properties": {
        "run_id": { "$ref": "#/$defs/Id" },
        "status": { "enum": ["queued", "running", "awaiting_user_decision", "completed", "failed"] },
        "started_at": { "$ref": "#/$defs/Timestamp" },
        "unanswered_questions": { "type": "array", "items": { "type": "string" } },
        "constraint_report": { "type": "array", "items": { "type": "string" } },
        "relaxation_options": { "type": "array", "items": { "type": "object" } },
        "error": { "$ref": "#/$defs/Failure" }
      },
      "additionalProperties": false
    },
    "AgentPatch": { "type": "object", "required": ["agent_id", "operations"], "properties": { "agent_id": { "type": "integer", "minimum": 1, "maximum": 10 }, "operations": { "type": "array", "items": { "type": "object", "required": ["op", "path"], "properties": { "op": { "enum": ["add", "replace", "remove", "test"] }, "path": { "type": "string", "pattern": "^/" }, "value": {} }, "additionalProperties": false } } }, "additionalProperties": false },
    "PlanningEvent": { "type": "object", "required": ["event_id", "type", "occurred_at", "trip_id", "run_id", "version"], "properties": { "event_id": { "$ref": "#/$defs/Id" }, "type": { "enum": ["trip.created", "discovery.updated", "planning.started", "agent.completed", "planning.awaiting_user_decision", "itinerary.published", "replan.requested", "planning.failed"] }, "occurred_at": { "$ref": "#/$defs/Timestamp" }, "trip_id": { "$ref": "#/$defs/Id" }, "run_id": { "$ref": "#/$defs/Id" }, "version": { "type": "integer", "minimum": 1 }, "payload": { "type": "object" } }, "additionalProperties": false }
  }
}
