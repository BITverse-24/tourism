{
    "compilerOptions": {
        "outDir": "./dist",
        "rootDir": "..",
        "module": "NodeNext",
        "target": "ES2022",
        "lib": ["ES2022"],
        "declaration": false,
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "types": ["node"]
    },
    "include": ["src", "test"],
    "exclude": ["node_modules", "dist"]
}
